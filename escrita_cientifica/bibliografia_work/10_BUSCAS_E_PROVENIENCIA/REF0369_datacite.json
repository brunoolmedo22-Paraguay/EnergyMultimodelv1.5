{"data":{"id":"10.5281/zenodo.22978126","type":"dois","attributes":{"doi":"10.5281/zenodo.22978126","prefix":"10.5281","suffix":"zenodo.22978126","identifiers":[{"identifier":"oai:zenodo.org:22978126","identifierType":"oai"}],"alternateIdentifiers":[{"alternateIdentifierType":"oai","alternateIdentifier":"oai:zenodo.org:22978126"}],"creators":[{"name":"Bruno Manuel O. Chavez","nameType":"Personal","familyName":"Bruno Manuel O. Chavez","nameIdentifiers":[],"affiliation":[]},{"name":"Marília Luiza Berti, Peruzzo","nameType":"Personal","givenName":"Peruzzo","familyName":"Marília Luiza Berti","nameIdentifiers":[],"affiliation":[]},{"name":"da Silva Mota, Ana Carolina","nameType":"Personal","givenName":"Ana Carolina","familyName":"da Silva Mota","nameIdentifiers":[{"nameIdentifier":"0000-0002-2025-1873","nameIdentifierScheme":"ORCID"}],"affiliation":[]},{"name":"Agripino Cruz, Pedro Germano","nameType":"Personal","givenName":"Pedro Germano","familyName":"Agripino Cruz","affiliation":["Universidade Federal da Paraíba"],"nameIdentifiers":[{"nameIdentifier":"0009-0003-0311-8936","nameIdentifierScheme":"ORCID"}]},{"name":"Ensina, Leandro Augusto","nameType":"Personal","givenName":"Leandro Augusto","familyName":"Ensina","affiliation":["Universidade Tecnológica Federal do Paraná"],"nameIdentifiers":[{"nameIdentifier":"0000-0002-4412-7316","nameIdentifierScheme":"ORCID"}]},{"name":"Ando Junior, Oswaldo Hideo","nameType":"Personal","givenName":"Oswaldo Hideo","familyName":"Ando Junior","affiliation":["Universidade Federal da Paraíba"],"nameIdentifiers":[{"nameIdentifier":"0000-0002-6951-0063","nameIdentifierScheme":"ORCID"}]},{"name":"Nunes Maciel, Joylan","nameType":"Personal","givenName":"Joylan","familyName":"Nunes Maciel","affiliation":["Universidade Federal da Integração Latino-Americana"],"nameIdentifiers":[{"nameIdentifier":"0000-0003-0725-6917","nameIdentifierScheme":"ORCID"}]},{"name":"Gimenez Ledesma, Jorge Javier","nameType":"Personal","givenName":"Jorge Javier","familyName":"Gimenez Ledesma","nameIdentifiers":[{"nameIdentifier":"0000-0002-5979-4955","nameIdentifierScheme":"ORCID"}],"affiliation":[]}],"titles":[{"title":"Desenvolvimento computacional e estimação de parâmetros de um modelo eletroquímico de célula a combustível PEM"}],"publisher":"Zenodo","container":{},"publicationYear":2026,"subjects":[{"subject":"PEMFC, modelagem eletroquímica, simulação computacional, identificação paramétrica, validação numérica, Python."}],"contributors":[],"dates":[{"date":"2026-10-20","dateType":"Issued"}],"language":"pt","types":{"ris":"CPAPER","bibtex":"article","citeproc":"","schemaOrg":"Article","resourceType":"","resourceTypeGeneral":"ConferencePaper"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.5281/zenodo.22978125","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":null,"rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Resumo: Este trabalho apresenta a implementação, em Python, de um modelo eletroquímico semiempírico de célula a combustível PEMFC baseado na formulação de Altıntaş e Ertan. Como as informações disponíveis na referência não permitem reproduzir diretamente todas as curvas publicadas, propõe-se uma metodologia de identificação paramétrica por mínimos quadrados não lineares, com múltiplas inicializações e restrições físicas. Os parâmetros eletroquímicos são identificados conjuntamente a partir das curvas de tensão em diferentes temperaturas e pressões, enquanto o número de células e o fator de utilização são determinados pelas curvas de potência e eficiência. O ajuste apresentou uma raiz do erro quadrático médio de 1,411 mV, equivalente a um erro normalizado de aproximadamente 0,183% em relação à tensão experimental média (0,773 V). Posteriormente, foram determinados número de células N = 41 células e fator de utilização de combustível igual a Uf = 0,6962. A principal contribuição consiste em um fluxo computacional reprodutível para implementação, identificação e validação do modelo, acompanhado de código, dados e uma plataforma interativa em Streamlit.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://zenodo.org/doi/10.5281/zenodo.22978126","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-09-26T14:27:57.000Z","registered":"2026-09-26T14:27:57.000Z","published":"2026","updated":"2026-10-19T14:33:22.000Z"},"relationships":{"client":{"data":{"id":"cern.zenodo","type":"clients"}},"provider":{"data":{"id":"cern","type":"providers"}},"media":{"data":{"id":"10.5281/zenodo.22978126","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[{"id":"10.5281/zenodo.22978125","type":"dois"}]}}}}